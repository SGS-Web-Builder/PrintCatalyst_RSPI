[Unit]
Description=PrintCatalyst Raspberry Pi service (development)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=printcatalyst-kiosk
Group=printcatalyst-kiosk
StateDirectory=printcatalyst-kiosk
StateDirectoryMode=0700
WorkingDirectory=/var/lib/printcatalyst-kiosk
Environment=PC_DATA_DIR=/var/lib/printcatalyst-kiosk
Environment=PC_BIND_HOST=127.0.0.1
Environment=HOME=/var/lib/printcatalyst-kiosk
LoadCredential=device-sealing-key:/etc/printcatalyst-kiosk/device-sealing.key
LoadCredential=kiosk-client-key:/etc/printcatalyst-kiosk/kiosk-client.key
ExecStart=/usr/local/lib/printcatalyst-kiosk/printcatalyst-kiosk
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/printcatalyst-kiosk

[Install]
WantedBy=multi-user.target
